// Elation X database schema — see docs/step-02-database.md.
//
// Conventions
// - IDs are UUIDv7 (time-ordered) generated by Prisma.
// - Money is integer PKR (`…Pkr` fields).
// - User, Event and File are soft-deleted (`deletedAt`); the Prisma client
//   extension in src/plugins/db.ts hides deleted rows by default.
// - Raw-SQL extras live in the migration: citext extension, the
//   "one primary moodboard per event" partial index.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  CLIENT
  CONSULTANT
  ADMIN
}

enum UserStatus {
  INVITED // invite sent, password not set yet
  ACTIVE
  EXPIRED // set by the expiry sweep; extending access reactivates
  REVOKED // manual; only an admin can restore
}

enum EventType {
  MEHNDI
  MAYOUN
  BARAAT
  WALIMA
  NIKKAH
  ENGAGEMENT
  BIRTHDAY
  CORPORATE_EVENT
  MILAD
  QAWWALI
  DINNER
  BRIDAL_SHOWER
  BABY_SHOWER
  ANNIVERSARY
  OTHER
}

enum VenueSetting {
  INDOOR
  OUTDOOR
  BOTH
}

enum EventStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryCategory {
  SOFA
  CHAIR
  TABLE
  CHANDELIER
  FLORAL
  BACKDROP
  PROP
  SIGNAGE
  LIGHTING
  FABRIC
}

enum InventoryUnit {
  EACH
  SET
  LINEAR_FT
  SQFT
}

enum MoodboardStatus {
  DRAFT // produced by a generation, not chosen yet
  SAVED // client kept it
  ARCHIVED
}

enum TileKind {
  INVENTORY // backed by an InventoryItem (inventory-aware)
  REFERENCE // client-uploaded reference image
  INSPIRATION // carried over from an adopted inspiration
}

enum BudgetPlanStatus {
  DRAFT
  SUBMITTED // client sent it to the consultant / requested a quote
  QUOTED // Elation confirmed a quote
}

enum QuoteStatus {
  OPEN
  IN_REVIEW
  QUOTED
  CLOSED
}

enum MessageKind {
  USER
  SYSTEM
}

enum ActivityKind {
  MOODBOARD
  BUDGET
  NOTE
  SYSTEM
  AR
  QUESTIONNAIRE
  EVENT
}

enum ARSetStatus {
  READY
  RENDERING
  COMING_SOON
}

enum FilePurpose {
  VENUE_MEDIA // questionnaire venue photos / floor plans
  REFERENCE_IMAGE // questionnaire references, moodboard reference tiles
  ATTACHMENT // chat
  AVATAR
  INVENTORY_IMAGE
  INSPIRATION_IMAGE
  AR_RENDER
  AR_MODEL // .glb / .obj
}

enum FileStatus {
  PENDING // presigned URL issued, upload not confirmed
  READY
}

enum InquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

// ─────────────────────────────── Users & access ───────────────────────────────

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique @db.Citext
  passwordHash    String?
  name            String
  phone           String?
  role            Role       @default(CLIENT)
  status          UserStatus @default(INVITED)
  accessExpiresAt DateTime? // clients only; null = no expiry (staff)
  consultantId    String?    @db.Uuid
  consultant      User?      @relation("ConsultantClients", fields: [consultantId], references: [id])
  clients         User[]     @relation("ConsultantClients")

  // profile (ProfilePage)
  avatarFileId          String? @db.Uuid
  city                  String?
  clientRole            String? // Bride | Groom | Family | Organizer
  partnerName           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notificationPrefs     Json    @default("{\"moodboardUpdates\":true,\"budgetAlerts\":true,\"consultantMessages\":true,\"weeklyDigest\":false,\"marketing\":false}")

  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  sessions      Session[]
  consents      Consent[]
  events        Event[]
  invitesSent   Invite[]            @relation("InviteCreatedBy")
  threadsJoined ThreadParticipant[]
  arNotify      ARNotifyRequest[]
  messages      Message[]
  files         File[]
  notesAbout    ConsultantNote[]    @relation("NoteClient")
  notesWritten  ConsultantNote[]    @relation("NoteAuthor")

  @@index([role, status])
  @@index([consultantId])
  @@index([accessExpiresAt])
}

model Session {
  id         String   @id // sha256(token) — the raw token only ever lives in the cookie
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  persistent Boolean  @default(true) // false = "remember me" off: browser-session cookie, short server TTL
  userAgent  String?
  ip         String?

  @@index([userId])
  @@index([expiresAt])
}

model Invite {
  id          String    @id @default(uuid(7)) @db.Uuid
  email       String    @db.Citext
  userId      String    @db.Uuid // the INVITED user row created alongside
  codeHash    String    @unique // sha256 of the one-time code
  accessDays  Int // copied to user.accessExpiresAt on acceptance
  createdById String    @db.Uuid
  createdBy   User      @relation("InviteCreatedBy", fields: [createdById], references: [id])
  expiresAt   DateTime // invite link validity
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model PasswordResetToken {
  id        String    @id // sha256(token)
  userId    String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Consent {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version     Int
  terms       Boolean
  dataUse     Boolean
  studioShare Boolean
  marketing   Boolean
  ip          String?
  acceptedAt  DateTime @default(now())

  @@index([userId, version])
}

// ─────────────────────────────── Events ───────────────────────────────

model Event {
  id           String        @id @default(uuid(7)) @db.Uuid
  clientId     String        @db.Uuid
  client       User          @relation(fields: [clientId], references: [id])
  name         String
  concept      String? // q2_name
  type         EventType // q1_type
  date         DateTime?     @db.Date // q3_date (nullable for early drafts)
  venueName    String? // q5_venue
  venueCity    String?
  venueSetting VenueSetting? // q6_indoor
  guests       Int? // q4_guests
  budgetPkr    Int? // explicit budget, or midpoint of the q121 band
  budgetBand   String? // q121_budget raw value
  coverFileId  String?       @db.Uuid
  coverUrl     String? // stock cover until a file is uploaded
  status       EventStatus   @default(DRAFT) // "past" is derived from date
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  questionnaire QuestionnaireResponse?
  moodboards    Moodboard[]
  budgetPlan    BudgetPlan?
  arSet         ARSet?
  files         File[]
  activity      ActivityEntry[]
  threads       Thread[]

  @@index([clientId, date])
  @@index([status])
  @@index([type])
}

// ─────────────────────────────── Questionnaire ───────────────────────────────

model QuestionnaireResponse {
  eventId         String    @id @db.Uuid
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  schemaVersion   Int // QUESTIONNAIRE_SCHEMA_VERSION from @elation/shared
  answers         Json      @default("{}") // Record<questionId, unknown>
  elationDecides  Json      @default("{}") // Record<questionId, boolean>
  percentComplete Int       @default(0) // cached from shared progress math on every write
  submittedAt     DateTime?
  version         Int       @default(1) // optimistic concurrency
  updatedAt       DateTime  @updatedAt
  updatedById     String?   @db.Uuid

  revisions QuestionnaireRevision[]

  // Analytics over answers (popular themes, budget bands …).
  @@index([answers(ops: JsonbPathOps)], type: Gin, map: "QuestionnaireResponse_answers_gin")
}

// Append-only. One row per save (a save may carry several question changes).
model QuestionnaireRevision {
  id        String                @id @default(uuid(7)) @db.Uuid
  eventId   String                @db.Uuid
  response  QuestionnaireResponse @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  actorId   String?               @db.Uuid
  changes   Json // [{ qid, from, to, decides? }]
  createdAt DateTime              @default(now())

  @@index([eventId, createdAt])
}

// ─────────────────────────────── Inventory ───────────────────────────────

model InventoryItem {
  id          String            @id @default(uuid(7)) @db.Uuid
  sku         String            @unique // Elation's code; stable key for spreadsheet re-imports
  name        String
  category    InventoryCategory
  colour      String
  colourHex   String?
  material    String?
  pricePkr    Int? // null = not priced yet ("price on request"); can't be added to a budget
  unit        InventoryUnit
  stockQty    Int? // null = not tracked / made to order
  imageFileId String?           @db.Uuid
  imageUrl    String?
  // Curation tags — lower-case, matched against questionnaire answers.
  tags        String[] // areas: stage, entrance, ceiling, dining, lounge, photo-area …
  moodTags    String[] // romantic, regal, dramatic, serene …
  styleTags   String[] // modern-luxury, traditional, garden …
  eventTypes  EventType[] // empty = suitable for all
  active      Boolean           @default(true)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  moodboardTiles   MoodboardTile[]
  budgetLines      BudgetLine[]
  inspirationItems InspirationItem[]

  @@index([category, active])
  @@index([tags], type: Gin)
  @@index([moodTags], type: Gin)
  @@index([styleTags], type: Gin)
}

// ─────────────────────────────── Moodboards ───────────────────────────────

model Moodboard {
  id                  String          @id @default(uuid(7)) @db.Uuid
  eventId             String          @db.Uuid
  event               Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  generationId        String          @db.Uuid // concepts produced together (A/B/C) share this
  variantLabel        String // "A" | "B" | "C"
  title               String
  status              MoodboardStatus @default(DRAFT)
  isPrimary           Boolean         @default(false) // the concept budget/AR follow; one per event (partial index)
  liked               Boolean         @default(false)
  palette             String[] // hex codes
  controls            Json // { mood, style, density, venue, venueLocked, palette }
  generator           String // "rules-v1" | "rules-v1+llm-v2" | "inspiration" | "fixture"
  narrative           String?
  sourceInspirationId String?         @db.Uuid
  coverTileId         String?         @db.Uuid
  createdById         String?         @db.Uuid
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  tiles MoodboardTile[]

  @@index([eventId, status])
  @@index([generationId])
}

model MoodboardTile {
  id              String         @id @default(uuid(7)) @db.Uuid
  moodboardId     String         @db.Uuid
  moodboard       Moodboard      @relation(fields: [moodboardId], references: [id], onDelete: Cascade)
  position        Int
  kind            TileKind
  inventoryItemId String?        @db.Uuid
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  fileId          String?        @db.Uuid // REFERENCE / INSPIRATION image
  imageUrl        String?
  area            String? // stage, entrance, ceiling … (the slot it fills)
  score           Float?
  reasons         String[] // ["palette: blush", "mood: romantic", "area: stage"]
  locked          Boolean        @default(false) // pinned by client; survives regenerate

  @@index([moodboardId, position])
  @@index([inventoryItemId])
}

// ─────────────────────────────── Budget ───────────────────────────────

model BudgetPlan {
  id          String           @id @default(uuid(7)) @db.Uuid
  eventId     String           @unique @db.Uuid
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  targetPkr   Int // writes through to Event.budgetPkr
  status      BudgetPlanStatus @default(DRAFT)
  seededFrom  String // "rules" | "moodboard" | "inspiration" | "blank" | "fixture"
  version     Int              @default(1)
  submittedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  updatedById String?          @db.Uuid

  lines  BudgetLine[]
  quotes QuoteRequest[]
}

model BudgetLine {
  id              String        @id @default(uuid(7)) @db.Uuid
  planId          String        @db.Uuid
  plan            BudgetPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  category        String // display group: Stage, Entrance, Florals, Lighting, Seating, Ceiling, Dining …
  inventoryItemId String        @db.Uuid
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  qty             Int
  unitPricePkr    Int // snapshot at add time (decision P7)
  included        Boolean       @default(true)
  position        Int
  source          String // "seed" | "client" | "consultant" | "moodboard" | "inspiration"
  createdAt       DateTime      @default(now())

  @@index([planId, position])
  @@index([inventoryItemId])
}

model QuoteRequest {
  id          String      @id @default(uuid(7)) @db.Uuid
  planId      String      @db.Uuid
  plan        BudgetPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  snapshot    Json // frozen lines + totals at request time
  note        String?
  status      QuoteStatus @default(OPEN)
  handledById String?     @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, createdAt])
}

// ─────────────────────────────── Inspirations ───────────────────────────────

model Inspiration {
  id         String      @id @default(uuid(7)) @db.Uuid
  slug       String      @unique
  name       String
  eventTypes EventType[]
  style      String
  palette    String[]
  coverUrl   String
  summary    String
  featured   Boolean     @default(false)
  budgetTier String? // Intimate | Signature | Grand
  published  Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tiles InspirationTile[]
  items InspirationItem[]
}

model InspirationTile {
  id            String      @id @default(uuid(7)) @db.Uuid
  inspirationId String      @db.Uuid
  inspiration   Inspiration @relation(fields: [inspirationId], references: [id], onDelete: Cascade)
  position      Int
  imageUrl      String
  caption       String?

  @@index([inspirationId, position])
}

model InspirationItem {
  id              String        @id @default(uuid(7)) @db.Uuid
  inspirationId   String        @db.Uuid
  inspiration     Inspiration   @relation(fields: [inspirationId], references: [id], onDelete: Cascade)
  inventoryItemId String        @db.Uuid
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  category        String
  qtyPer100Guests Int? // scales with the adopting event's guest count
  qtyFixed        Int? // e.g. 1 backdrop regardless of guests

  @@index([inspirationId])
}

// ─────────────────────────────── AR ───────────────────────────────

model ARSet {
  id              String      @id @default(uuid(7)) @db.Uuid
  eventId         String?     @unique @db.Uuid
  event           Event?      @relation(fields: [eventId], references: [id])
  eventType       EventType
  title           String
  theme           String
  status          ARSetStatus @default(COMING_SOON)
  progressPercent Int         @default(0)
  eta             DateTime?   @db.Date
  coverUrl        String
  floorPlanUrl    String?
  aerialUrls      String[]
  summary         String
  highlights      String[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  assets   ARAsset[]
  notifyMe ARNotifyRequest[]
}

/// "Notify me" on a coming-soon set — emailed when it turns READY (docs/step-09-inspirations-ar.md).
model ARNotifyRequest {
  id         String    @id @default(uuid(7)) @db.Uuid
  setId      String    @db.Uuid
  set        ARSet     @relation(fields: [setId], references: [id], onDelete: Cascade)
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([setId, userId])
  @@index([userId])
}

model ARAsset {
  id              String  @id @default(uuid(7)) @db.Uuid
  setId           String  @db.Uuid
  set             ARSet   @relation(fields: [setId], references: [id], onDelete: Cascade)
  name            String
  inventoryItemId String? @db.Uuid
  modelFileId     String? @db.Uuid // GLB/OBJ in the private bucket
  thumbnailUrl    String?
  source          String? // "Tripo AI" | "Meshy AI" | "manual"

  @@index([setId])
}

// ─────────────────────────────── Chat history ───────────────────────────────

model Thread {
  id            String   @id @default(uuid(7)) @db.Uuid
  clientId      String   @db.Uuid // whose conversation this is (scopes access)
  eventId       String?  @db.Uuid
  event         Event?   @relation(fields: [eventId], references: [id])
  title         String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  participants ThreadParticipant[]
  messages     Message[]

  @@index([clientId, lastMessageAt])
  @@index([eventId])
}

model ThreadParticipant {
  threadId             String    @db.Uuid
  thread               Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId               String    @db.Uuid
  user                 User      @relation(fields: [userId], references: [id])
  lastReadMessageId    String?   @db.Uuid
  lastReadAt           DateTime?
  /// Newest message already covered by an unread-messages email (Step 10 digest).
  lastEmailedMessageId String?   @db.Uuid
  joinedAt             DateTime  @default(now())

  @@id([threadId, userId])
  @@index([userId])
}

model Message {
  id              String      @id @default(uuid(7)) @db.Uuid // UUIDv7 → ordering by id = ordering by time
  threadId        String      @db.Uuid
  thread          Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId        String?     @db.Uuid // null for SYSTEM messages
  author          User?       @relation(fields: [authorId], references: [id])
  kind            MessageKind @default(USER)
  body            String
  /// Sender-generated id: retries are idempotent and the UI reconciles optimistic messages.
  clientMessageId String?
  meta            Json? // SYSTEM: { type: "moodboard.generated", moodboardId }
  createdAt       DateTime    @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?

  attachments File[]

  @@unique([authorId, clientMessageId])
  @@index([threadId, id])
}

// ─────────────────────────────── Files ───────────────────────────────

model File {
  id         String      @id @default(uuid(7)) @db.Uuid
  ownerId    String      @db.Uuid
  owner      User        @relation(fields: [ownerId], references: [id])
  eventId    String?     @db.Uuid
  event      Event?      @relation(fields: [eventId], references: [id])
  messageId  String?     @db.Uuid
  message    Message?    @relation(fields: [messageId], references: [id])
  questionId String? // e.g. "q8_upload"
  purpose    FilePurpose
  bucket     String // private | public
  key        String      @unique
  filename   String
  mime       String
  sizeBytes  Int
  width      Int?
  height     Int?
  status     FileStatus  @default(PENDING)
  /// Processed copies of photos (EXIF stripped): 400 px and 1600 px WebP.
  thumbKey   String?
  previewKey String?
  createdAt  DateTime    @default(now())
  deletedAt  DateTime?

  @@index([eventId, purpose])
  @@index([status, createdAt])
}

// ─────────────────────────────── Activity, admin, audit ───────────────────────────────

model ActivityEntry {
  id        String       @id @default(uuid(7)) @db.Uuid
  clientId  String       @db.Uuid
  eventId   String?      @db.Uuid
  event     Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actorId   String?      @db.Uuid
  kind      ActivityKind
  title     String
  detail    String?
  meta      Json?
  createdAt DateTime     @default(now())

  @@index([clientId, createdAt])
  @@index([eventId, createdAt])
}

model ConsultantNote {
  id         String    @id @default(uuid(7)) @db.Uuid
  clientId   String    @db.Uuid
  client     User      @relation("NoteClient", fields: [clientId], references: [id])
  authorId   String    @db.Uuid
  author     User      @relation("NoteAuthor", fields: [authorId], references: [id])
  eventId    String?   @db.Uuid
  body       String
  followUpAt DateTime?
  doneAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([clientId, createdAt])
  @@index([followUpAt])
}

model Inquiry {
  id              String        @id @default(uuid(7)) @db.Uuid
  name            String
  email           String        @db.Citext
  phone           String?
  eventType       EventType?
  eventDate       DateTime?     @db.Date
  guestRange      String?
  city            String?
  budgetBand      String?
  source          String? // "how did you hear about us"
  message         String?
  status          InquiryStatus @default(NEW)
  convertedUserId String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  action     String // "user.invite" | "user.extend" | "user.revoke" | "inventory.update" …
  targetType String
  targetId   String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

/// Admin settings (docs/step-12-admin.md): one row per key, JSON value.
model Setting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
}
