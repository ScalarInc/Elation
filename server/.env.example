# Copy to .env for local development. Railway sets these as service variables.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local Postgres from docker-compose.yml (npm run db:up)
DATABASE_URL=postgresql://elation:elation@localhost:55432/elation
DATABASE_URL_TEST=postgresql://elation:elation@localhost:55432/elation_test

WEB_ORIGIN=http://localhost:5173
SESSION_COOKIE_DOMAIN=
SESSION_TTL_DAYS=14
DEFAULT_CLIENT_ACCESS_DAYS=90
EXPIRED_DATA_RETENTION_DAYS=7

# Links in emails point here (in production: the Railway URL)
APP_URL=http://localhost:5173

# Email: leave RESEND_API_KEY empty in dev — invite/reset links are printed to the server log
RESEND_API_KEY=
MAIL_FROM="Elation X <onboarding@resend.dev>"

# Production only: path to the built webapp so one service serves web + API
SERVE_WEBAPP_DIST=

# Added in later steps:
# R2_ACCOUNT_ID= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY=
# R2_PRIVATE_BUCKET=elation-private R2_PUBLIC_BUCKET=elation-public R2_PUBLIC_BASE_URL=
# SENTRY_DSN=
# ANTHROPIC_API_KEY=   (v2 moodboard re-rank only)
