# Copy to .env for local development. In staging/production these are Railway
# service variables — the full list, with what each environment needs, is in
# server/RUNBOOK.md. The server refuses to start on invalid configuration.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local Postgres from docker-compose.yml (npm run db:up)
DATABASE_URL=postgresql://elation:elation@localhost:55432/elation
DATABASE_URL_TEST=postgresql://elation:elation@localhost:55432/elation_test
# Optional: direct connection for realtime LISTEN when DATABASE_URL is a transaction pooler
DATABASE_LISTEN_URL=

WEB_ORIGIN=http://localhost:5173
SESSION_COOKIE_DOMAIN=
SESSION_TTL_DAYS=14
DEFAULT_CLIENT_ACCESS_DAYS=90
# Expired clients' data is deleted this many days after access ends (owner answer A5)
EXPIRED_DATA_RETENTION_DAYS=7

# Links in emails point here (in production: the Railway URL). Also feeds the CSP's websocket origin.
APP_URL=http://localhost:5173

# Email: leave RESEND_API_KEY empty in dev — emails (links included) are printed to the server log.
# Outside development, no key = emails are not sent (and never logged).
RESEND_API_KEY=
MAIL_FROM="Elation X <onboarding@resend.dev>"

# Production only: path to the built webapp so one service serves web + API (the Docker image sets it)
SERVE_WEBAPP_DIST=

# File storage — empty = local disk (dev/tests). Required in production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=elation-private
R2_PUBLIC_BUCKET=elation-public
# Public bucket's CDN origin (r2.dev URL or custom domain) — required in production
R2_PUBLIC_BASE_URL=
# Optional: any S3-compatible endpoint instead of R2 (e.g. MinIO at http://localhost:9000)
R2_ENDPOINT=
# Signs local-storage links (dev only)
STORAGE_SIGNING_SECRET=dev-only-storage-signing-secret

# Error reporting — optional; without a DSN nothing is sent.
SENTRY_DSN=
SENTRY_WEB_DSN=
SENTRY_ENVIRONMENT=development
# Release tag for error reports; deploys set it to the commit (Railway also sets RAILWAY_GIT_COMMIT_SHA)
RELEASE=

# Later: ANTHROPIC_API_KEY= (v2 moodboard re-rank only)
