{
  "name": "elation-x",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "server",
    "webapp"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace webapp",
    "build": "npm run build --workspace webapp && npm run build --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "audit:deps": "node scripts/audit.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "oxlint": "^1.79.0"
  }
}
