{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@/mocks/fixtures",
            "importNames": [
              "events"
            ],
            "message": "Events come from the API \u2014 use the hooks in @/data/events (docs/step-04-events.md)."
          }
        ]
      }
    ]
  }
}
