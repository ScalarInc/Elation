# Elation X: environment template
# Copy to `.env` in this same folder (repo root) and fill in the values there.
# Do NOT put real values in this file: it is committed to git.
# Only variables prefixed with VITE_ are exposed to the browser.

# ---------------------------------------------------------------------
# App (defaults work for local dev)
# ---------------------------------------------------------------------
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
API_PORT=8787
VITE_API_URL=http://127.0.0.1:8787

# ---------------------------------------------------------------------
# Supabase (MANDATORY)
# Dashboard -> Project Settings -> API Keys / Connect
# ---------------------------------------------------------------------
# Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_...). Server only, never prefix with VITE_.
SUPABASE_SECRET_KEY=
# Postgres connection string: use "Session pooler" (port 5432), include the DB password.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Frontend copies (publishable key is safe in the browser; it is used for sign-in only)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------
# First admin (MANDATORY)
# No password here: `npm run create-superuser` prints a one-time set-password link.
# ---------------------------------------------------------------------
SUPERUSER_EMAIL=
SUPERUSER_NAME=Elation Admin

# ---------------------------------------------------------------------
# Client accounts
# ---------------------------------------------------------------------
CLIENT_ACCESS_DEFAULT_DAYS=30

# ---------------------------------------------------------------------
# Groq (OPTIONAL until moodboard generation; rule-based fallback without it)
# console.groq.com -> API Keys
# ---------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=20000

# ---------------------------------------------------------------------
# Resend (OPTIONAL; only for emailed invites / password resets / notifications)
# resend.com -> API Keys, and a verified domain
# ---------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Elation X <no-reply@your-domain.example>
ADMIN_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------
# Tests (OPTIONAL; separate database so tests never touch real data)
# ---------------------------------------------------------------------
TEST_DATABASE_URL=
